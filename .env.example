# Sharing Tuesday — environment variables
# Copy to .env.local and fill in. Server-only secrets must NEVER get a
# NEXT_PUBLIC_ prefix — that would ship them to the browser.

# ---------------------------------------------------------------------------
# Supabase (client + server)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon API key. Safe for the browser: clients can only READ, under RLS,
# with a server-minted scoped room JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase (SERVER ONLY — never expose)
# ---------------------------------------------------------------------------
# Service-role key. Bypasses RLS; performs every mutation and is the only
# key allowed to call the SECURITY DEFINER RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# The project's JWT secret (Supabase dashboard -> Settings -> API).
# Signs the short-lived per-room scoped JWT (claims: role=anon, room_id).
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# App auth (SERVER ONLY — never expose)
# ---------------------------------------------------------------------------
# The single shared facilitator password (spec §2). Verified server-side
# with a constant-time compare; never present in any client bundle.
#
# ROTATING THIS NOW REVOKES EVERY LIVE FACILITATOR SESSION immediately: the
# session token carries a fingerprint derived from this value. Previously
# rotation did nothing to already-issued tokens, which stayed valid for 12h.
FACILITATOR_PASSWORD=

# Optional manual session-version bump. Change to any new value to force-log
# out every facilitator WITHOUT changing the password. Defaults to "1".
FACILITATOR_SESSION_VERSION=

# ---------------------------------------------------------------------------
# Token signing secrets (SERVER ONLY — never expose)
# ---------------------------------------------------------------------------
# Two token types, two separate secrets. They used to share SESSION_SECRET,
# which made rotation destructive: rotating it invalidated every participant
# seat cookie at once, so joinRoom stopped recognising returning participants
# and silently re-inserted them as duplicates with new fun names.
#
# Generate each with: openssl rand -base64 32

# Signs the facilitator session cookie (HS256, aud "facilitator-session").
FACILITATOR_SESSION_SECRET=

# Signs the per-room participant seat cookie (HS256, aud "participant-seat").
PARTICIPANT_COOKIE_SECRET=

# --- Rotation (verify-only, optional) --------------------------------------
# To rotate WITHOUT logging anyone out:
#   1. Copy the current value into the matching _PREVIOUS variable.
#   2. Put the new value in the primary variable.
#   3. Deploy. Live sessions keep verifying against _PREVIOUS until they
#      expire; new tokens are signed with the new secret.
#   4. Remove _PREVIOUS on the next deploy.
# These are NEVER used for signing.
FACILITATOR_SESSION_SECRET_PREVIOUS=
PARTICIPANT_COOKIE_SECRET_PREVIOUS=

# --- Legacy ----------------------------------------------------------------
# The original single shared secret. Still honoured as a fallback for BOTH
# token types (signing when the dedicated vars above are unset, and always as
# a verify-only fallback) so an existing deployment keeps working. Once
# FACILITATOR_SESSION_SECRET and PARTICIPANT_COOKIE_SECRET are set everywhere
# and old sessions have expired (12h), this can be removed.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Absolute base URL used in join links + QR codes, e.g.
# https://games.gamaleldien.com/random-selector
#
# SET THIS IN PRODUCTION. It is what the projection screen encodes into the
# QR code participants scan. Without it the value is derived from request
# headers, which are attacker-controllable; the code now refuses any host not
# on the allow-list in src/lib/baseUrl.ts rather than trusting them.
NEXT_PUBLIC_APP_URL=
