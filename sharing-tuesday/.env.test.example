# Sharing Tuesday — LIVE TEST environment (`npm run test:live`)
#
# Copy to `.env.test` and point it at a THROWAWAY Supabase project.
#
# WHY THIS FILE EXISTS
# The live suites are destructive: they create rooms, drive 25 concurrent
# joins, and call deleteRoom. They used to read `.env.local` — the same file
# the real app uses — so a stray `npm run test:live` mutated and deleted
# PRODUCTION data and permanently burned production room codes.
#
# The runner now refuses to start if these point at the production project
# (detected from supabase/.temp/project-ref and .env.local). There is no
# fallback and no override flag: use a separate project.
#
# SETUP
#   1. Create a second, free Supabase project (e.g. "sharing-tuesday-test").
#   2. Apply the schema:  supabase/migrations/0001..0006  (in order).
#   3. Fill in the values below from that project's dashboard.
#
# `.env.test` is git-ignored. Never put production keys in it.

# Test project URL, e.g. https://abcdefghij.supabase.co
# MUST NOT be the production project ref.
TEST_SUPABASE_URL=

# Test project service-role key (bypasses RLS — test project only).
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Any password you like; the suites log in with it against the test app.
TEST_FACILITATOR_PASSWORD=

# --- Optional: only needed by the spawned app, not the DB-level suites -----

# Test project anon key.
TEST_SUPABASE_ANON_KEY=

# Test project JWT secret (Settings -> API), signs scoped room tokens.
TEST_SUPABASE_JWT_SECRET=

# Cookie/session signing secret for the test app.
# Generate with: openssl rand -base64 32
TEST_SESSION_SECRET=
